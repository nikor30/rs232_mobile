# Settings for docker-compose.cloud.yml. Copy to .env (which git ignores) and fill in.

# The name the server is reached under; its DNS entry must point at this machine.
C2_DOMAIN=leitstelle.example.org
# E-mail address for Let's Encrypt, or "internal" for a test without the internet.
C2_CADDY_TLS=admin@example.org
# Password of the database. Letters and digits only (it becomes part of a URL):
#   openssl rand -hex 24
C2_DB_PASSWORD=
# Needed until the first account exists (at least 16 characters); empty afterwards.
C2_ADMIN_TOKEN=

# Sign-in with Microsoft Entra ID (README.md); all three or none.
#C2_ENTRA_TENANT=
#C2_ENTRA_CLIENT_ID=
#C2_ENTRA_CLIENT_SECRET=
