// RS232 console server - snap-together enclosure (portrait module, USB-C at the top edge)
// GENERATED by hardware/enclosure/generate_enclosure.py - edit the parameters there.
// part = 0: assembly preview (shell lifted), 1: tub, 2: shell, 3: battery door, 4: exploded
part = 0;
$fn = 48;

pcb_w = 78.0;
pcb_h = 107.0;
pcb_t = 1.6;
gap = 0.5;
wall = 2.0;
end_wall = 3.6;
floor_t = 1.6;
corner_r = 3.0;
clr = 0.3;
bat_t = 7.0;
pin_clr = 2.0;
z_part = 7.0;
z_top = 16.1;
plate_t = 2.0;
ws_x0 = 1.0;
ws_y0 = 1.0;
ws_w = 34.2;
ws_l = 47.4;
glass_w = 35.5;
glass_l = 56.5;
z_glass_bot = 12.6;
ch_pitch = 19.0;
ch_x0 = 10.4;
rj_w = 16.5;
rj_h = 14.0;
usb_x = 18.200000000000003;
usb_z = 9.4;
btn_x1 = 29.450000000000003;
btn_x2 = 6.950000000000003;
btn_z = 9.4;
sd_y1 = 10.899999999999999;
sd_y2 = 22.9;
sd_z = 9.6;
sma_y = 53.0;
sma_z = 10.5;
sma_d = 6.5;
hook_w = 9.0;
hook_t = 1.5;
hook_len = 6.0;
hook_catch = 1.0;
hook_ys = [24.0, 79.0];
door_x1 = 9.0;
door_x2 = 69.0;
door_y1 = 20.0;
door_y2 = 88.0;
door_t = 1.6;
door_lip = 2.0;
holes_m25 = [[74.5, 3.5], [74.5, 46.0], [20.0, 83.5], [58.0, 83.5]];
holes_m2 = [[32.4, 45.7], [3.8, 45.7], [32.4, 3.7], [3.8, 3.7]];

cav_x1 = -gap;  cav_x2 = pcb_w + gap;
cav_y1 = -gap;  cav_y2 = pcb_h + gap;
out_x1 = cav_x1 - wall; out_x2 = cav_x2 + wall;
out_y1 = cav_y1 - end_wall; out_y2 = cav_y2 + wall;
z_pcb_bot = -pcb_t;
z_floor_top = z_pcb_bot - pin_clr - bat_t;
z_floor_bot = z_floor_top - floor_t;
z_plate_bot = z_top - plate_t;
lip_t = 1.2; lip_h = 3.0;

module rbox(x1, y1, x2, y2, z1, z2, r) {
    hull() for (x = [x1 + r, x2 - r], y = [y1 + r, y2 - r]) translate([x, y, z1]) cylinder(r = r, h = z2 - z1);
}
module box(x1, y1, x2, y2, z1, z2) { translate([x1, y1, z1]) cube([x2 - x1, y2 - y1, z2 - z1]); }

// ------------------------------------------------------------------ openings shared by tub and shell
module side_openings() {
    // RJ45 jacks, front wall, open to the top of the tub (closed by the shell)
    for (i = [0:3]) box(ch_x0 + i * ch_pitch - rj_w / 2, cav_y2 - 1, ch_x0 + i * ch_pitch + rj_w / 2, out_y2 + 1, -0.3, rj_h);
    // USB-C well in the top (end) wall
    box(usb_x - 6.5, out_y1 - 1, usb_x + 6.5, cav_y1 + 1, usb_z - 4, usb_z + 4);
    // BOOT / RST pin holes
    for (x = [btn_x1, btn_x2]) translate([x, out_y1 - 1, btn_z]) rotate([-90, 0, 0]) cylinder(d = 2.5, h = end_wall + 2);
    // micro-SD slot, left wall
    box(out_x1 - 1, sd_y1, cav_x1 + 1, sd_y2, sd_z - 1.4, sd_z + 1.4);
    // RP-SMA bulkhead, left wall
    translate([out_x1 - 1, sma_y, sma_z]) rotate([0, 90, 0]) cylinder(d = sma_d, h = wall + 2);
}

// ------------------------------------------------------------------ snap hooks (on the shell)
// A hook hangs from the shell's inner lip, the catch points outwards into a window of the tub wall.
module hook(side) {        // side = -1 left wall, +1 right wall
    xw = side < 0 ? cav_x1 : cav_x2;              // inner face of the wall
    dir = side;                                  // outward direction
    L = hook_len; t = hook_t; c = hook_catch;
    translate([xw, 0, z_part]) mirror([side < 0 ? 1 : 0, 0, 0]) {
        // cantilever: from the lip downwards, thickness t, just inside the wall
        translate([-t, -hook_w / 2, -L]) cube([t, hook_w, L + 0.01]);
        // catch at the tip: 30 deg lead-in below (insertion), 45 deg return above (releasable)
        translate([0, hook_w / 2, 0]) rotate([90, 0, 0])
            linear_extrude(hook_w) polygon([[-0.01, -L], [c, -L + 1.732 * c], [-0.01, -L + 2.732 * c]]);
        // root fillet
        translate([-t - 0.8, -hook_w / 2, -0.01]) difference() { cube([0.8, hook_w, 0.8]); translate([0, -1, 0.8]) rotate([-90, 0, 0]) cylinder(r = 0.8, h = hook_w + 2); }
    }
}
module hook_windows() {
    // through windows in the tub walls where the catches engage, with 0.3 mm play
    c = hook_catch; wh = 2.732 * c + 2 * clr;
    for (y = hook_ys) for (side = [-1, 1]) {
        xw = side < 0 ? out_x1 : cav_x2;
        box(xw - 0.5, y - hook_w / 2 - clr, xw + wall + 0.5, y + hook_w / 2 + clr, z_part - hook_len - clr, z_part - hook_len - clr + wh);
    }
}

// ------------------------------------------------------------------ carrier posts
module tub_posts() {
    for (h = holes_m25) translate([h[0], h[1], z_floor_top - 0.1]) {
        cylinder(d = 5.5, h = z_pcb_bot - z_floor_top + 0.1);                 // shoulder carries the PCB
        cylinder(d = 2.4, h = z_pcb_bot - z_floor_top + 0.1 + pcb_t + 2.0);   // pin through the hole into the shell post
    }
    for (h = holes_m2) translate([h[0], h[1], z_floor_top - 0.1]) {
        cylinder(d = 5.0, h = z_pcb_bot - z_floor_top + 0.1);
        cylinder(d = 1.9, h = z_pcb_bot - z_floor_top + 0.1 + pcb_t + 1.0);   // locates the module standoff
    }
}
module shell_posts() {
    for (h = holes_m25) difference() {
        translate([h[0], h[1], 0.3]) cylinder(d = 6.0, h = z_plate_bot - 0.3 + 0.1);
        translate([h[0], h[1], -1]) cylinder(d = 2.4 + 2 * clr, h = 4);                // takes the tub pin
    }
}

// ------------------------------------------------------------------ battery door
module door_cut() {   // opening + rebate in the floor
    box(door_x1, door_y1, door_x2, door_y2, z_floor_bot - 1, z_floor_top + 1);
    box(door_x1 - door_lip, door_y1 - door_lip, door_x2 + door_lip, door_y2 + door_lip, z_floor_bot - 1, z_floor_bot + door_t);
    // latch window and fingernail notch at the y2 end
    box((door_x1 + door_x2) / 2 - 6, door_y2 + door_lip - 0.01, (door_x1 + door_x2) / 2 + 6, door_y2 + door_lip + 1.6, z_floor_bot - 1, z_floor_bot + door_t + 1.2);
    box((door_x1 + door_x2) / 2 - 6, door_y2 + door_lip + 1.6, (door_x1 + door_x2) / 2 + 6, door_y2 + door_lip + 4.5, z_floor_bot - 1, z_floor_bot + 0.8);
}
module door() {
    dx1 = door_x1 - door_lip + clr; dx2 = door_x2 + door_lip - clr;
    dy1 = door_y1 - door_lip + clr; dy2 = door_y2 + door_lip - clr;
    cx = (door_x1 + door_x2) / 2;
    difference() {
        union() {
            box(dx1, dy1, dx2, dy2, z_floor_bot, z_floor_bot + door_t);
            // two fixed tabs that slide under the floor at the y1 end
            for (x = [dx1 + 8, dx2 - 8]) box(x - 4, dy1 - 3.0, x + 4, dy1 + 0.01, z_floor_bot + door_t, z_floor_bot + door_t + 1.2);
            for (x = [dx1 + 8, dx2 - 8]) box(x - 4, dy1 - 3.0, x + 4, dy1 - 1.0, z_floor_bot + door_t - 0.6, z_floor_bot + door_t + 1.2);
            // cantilever latch at the y2 end (in the plane of the door: prints flat, flexes well)
            box(cx - 5, dy2 - 12, cx + 5, dy2 + 1.0, z_floor_bot, z_floor_bot + 1.2);
            box(cx - 5, dy2 - 0.01, cx + 5, dy2 + 1.0, z_floor_bot, z_floor_bot + door_t + 1.0);   // catch
            // thumb nub
            box(cx - 3, dy2 - 6, cx + 3, dy2 - 2, z_floor_bot - 0.8, z_floor_bot);
        }
        // slot that frees the latch cantilever from the door plate
        for (x = [cx - 5.6, cx + 5]) box(x, dy2 - 12, x + 0.6, dy2 + 1.5, z_floor_bot - 1, z_floor_bot + 5);
        box(cx - 5.6, dy2 - 12, cx + 5.6, dy2 - 11.4, z_floor_bot + 1.2, z_floor_bot + 5);
        // lead-in chamfer on the catch
        translate([cx - 6, dy2 + 1.0, z_floor_bot + door_t + 1.0]) rotate([45, 0, 0]) cube([12, 1.5, 1.5]);
    }
}

// ------------------------------------------------------------------ the parts
module tub() {
    difference() {
        rbox(out_x1, out_y1, out_x2, out_y2, z_floor_bot, z_part, corner_r);
        box(cav_x1, cav_y1, cav_x2, cav_y2, z_floor_top, 100);
        side_openings();
        hook_windows();
        door_cut();
        // groove for the shell's lip, cut into the wall
        difference() {
            box(cav_x1 - lip_t - clr, cav_y1 - lip_t - clr, cav_x2 + lip_t + clr, cav_y2 + lip_t + clr, z_part - lip_h - clr, z_part + 1);
            box(cav_x1 - 0.01, cav_y1 - 0.01, cav_x2 + 0.01, cav_y2 + 0.01, z_part - lip_h - clr - 1, z_part + 2);
        }
    }
    tub_posts();
}

module shell() {
    gx1 = (ws_x0 + ws_x0 + ws_w) / 2 - glass_w / 2 - 0.15;
    gx2 = (ws_x0 + ws_x0 + ws_w) / 2 + glass_w / 2 + 0.15;
    gy1 = ws_y0 + ws_l / 2 - glass_l / 2 - 0.15;
    gy2 = ws_y0 + ws_l / 2 + glass_l / 2 + 0.15;
    difference() {
        union() {
            rbox(out_x1, out_y1, out_x2, out_y2, z_part, z_top, corner_r);
            // alignment lip into the tub wall groove
            difference() {
                box(cav_x1 - lip_t, cav_y1 - lip_t, cav_x2 + lip_t, cav_y2 + lip_t, z_part - lip_h, z_part + 0.01);
                box(cav_x1, cav_y1, cav_x2, cav_y2, z_part - lip_h - 1, z_part + 1);
            }
            for (y = hook_ys) for (side = [-1, 1]) translate([0, y, 0]) hook(side);
            shell_posts();
        }
        box(cav_x1, cav_y1, cav_x2, cav_y2, -100, z_plate_bot);        // cavity
        // display glass: the glass itself is the top surface, the plate frames it with 0.15 mm play
        box(gx1, out_y1 - 1, gx2, gy2, z_plate_bot - 1, z_top + 1);             // glass window, open at the USB-C end
        box(gx1, out_y1 - 1, gx2, cav_y1 + 1, z_glass_bot - 0.3, z_top + 1);   // end wall sits under the glass overhang
        side_openings();
        // the lip must not cover the jack openings nor the USB well
        for (i = [0:3]) box(ch_x0 + i * ch_pitch - rj_w / 2, cav_y2 - 3, ch_x0 + i * ch_pitch + rj_w / 2, cav_y2 + 1, z_part - lip_h - 1, z_part + 0.5);
        box(usb_x - 6.5, cav_y1 - 1, usb_x + 6.5, cav_y1 + 3, z_part - lip_h - 1, z_part + 0.5);
    }
}

module carrier_preview() {
    color("green", 0.6) box(0, 0, pcb_w, pcb_h, z_pcb_bot, 0);
    for (i = [0:3]) color("silver") box(ch_x0 + i * ch_pitch - 7.95, pcb_h - 20.3, ch_x0 + i * ch_pitch + 7.95, pcb_h + 1, 0, 13.5);
    color("royalblue", 0.7) box(ws_x0, ws_y0, ws_x0 + ws_w, ws_y0 + ws_l, z_glass_bot - 1.6, z_glass_bot);
    color("black", 0.9) box(ws_x0 + ws_w / 2 - glass_w / 2, ws_y0 + ws_l / 2 - glass_l / 2, ws_x0 + ws_w / 2 + glass_w / 2, ws_y0 + ws_l / 2 + glass_l / 2, z_glass_bot, z_top);
    color("orange", 0.5) box(door_x1 + 3, door_y1 + 3, door_x1 + 3 + 50, door_y1 + 3 + 60, z_floor_top, z_floor_top + 6);
}

if (part == 1) tub();
else if (part == 2) shell();
else if (part == 3) door();
else if (part == 4) { tub(); translate([0, 0, 30]) shell(); translate([0, 0, -25]) door(); carrier_preview(); }
else { tub(); translate([0, 0, 14]) shell(); door(); carrier_preview(); }
